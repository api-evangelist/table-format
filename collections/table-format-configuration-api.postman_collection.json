            },
            "url": {
              "path": [
                "v1",
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "warehouse",
                  "value": "<string>",
                  "description": "Warehouse identifier for multi-tenant catalogs"
                }
              ],
              "variable": [
                {
                  "description": "Hostname and port of the Iceberg REST catalog service",
                  "type": "any",
                  "value": "{{catalog-host}}",
                  "key": "catalog-host"
                }
