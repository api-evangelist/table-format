{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Iceberg REST Catalog Commits OAuth2 API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth2",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get OAuth2 Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{catalog-host}/v1/oauth/tokens",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange credentials for an OAuth2 access token for catalog access."
        }
      ]
    }
  ],
  "bundled": true
}